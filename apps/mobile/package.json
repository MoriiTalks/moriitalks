{
  "name": "@moriitalks/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare:styles": "uniwind generate-artifacts --css ./global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "pnpm prepare:styles && tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:all": "expo export --platform all"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uniwind": "1.12.2"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "24.0.0",
    "@types/react": "~19.2.17",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
