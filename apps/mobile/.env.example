# Public backend address only, provider keys belong in the Go process environment.
# Android emulator defaults to http://10.0.2.2:8080, web and iOS to http://127.0.0.1:8080.
# Leave this unset to use those platform defaults.
# For a USB Android device, use adb reverse tcp:8080 tcp:8080 and enable this loopback URL.
# EXPO_PUBLIC_VOICE_API_URL=http://127.0.0.1:8080
