{
  "expo": {
    "name": "MoriiTalks",
    "slug": "moriitalks",
    "version": "0.1.0",
    "scheme": "moriitalks",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/morii-icon.png",
    "ios": {
      "bundleIdentifier": "com.moriitalks.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.moriitalks.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/morii-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MoriiTalks uses your microphone only during a voice conversation you start.",
          "speechRecognitionPermission": "MoriiTalks uses device speech recognition to turn your words into text during a voice conversation."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MoriiTalks uses your microphone only when you start a voice turn.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
