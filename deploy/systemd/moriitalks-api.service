[Unit]
Description=MoriiTalks adult API lab
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/moriitalks/api.env

[Service]
Type=simple
DynamicUser=yes
User=moriitalks-api
WorkingDirectory=/opt/moriitalks
EnvironmentFile=/etc/moriitalks/api.env
Environment=GOMEMLIMIT=192MiB
ExecStart=/opt/moriitalks/api
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
