{$MORII_DOMAIN} {
	basic_auth {
		{$MORII_DEMO_USER} {$MORII_DEMO_PASSWORD_HASH}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		Cache-Control "private, no-cache"
	}

	encode zstd gzip
	@api path /healthz /v1/* /v2/*
	handle @api {
		# Caddy preserves the browser Origin and upgrades WebSockets automatically.
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /opt/moriitalks/current/web
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
