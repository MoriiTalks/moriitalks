{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "animation": {
      "type": "string",
      "enum": ["neutral", "wave", "think", "encourage"]
    },
    "panel": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "show_hint"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": ["type", "title", "text"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "show_choices"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "choices": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "enum": ["hobby", "day", "ideas"]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      }
                    },
                    "required": ["id", "label"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["type", "title", "choices"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "show_outline"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "parts": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              },
              "required": ["type", "title", "parts"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "propose_feedback"
                },
                "quote": {
                  "type": "string",
                  "maxLength": 300
                },
                "observation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "rubricId": {
                  "type": "string",
                  "const": "idea-and-reason-v1"
                },
                "status": {
                  "type": "string",
                  "enum": ["observed", "needs_practice", "not_observed", "unassessable"]
                }
              },
              "required": ["type", "quote", "observation", "nextStep", "rubricId", "status"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "propose_next_mission"
                },
                "missionId": {
                  "type": "string",
                  "const": "first-explanation"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": ["type", "missionId", "title", "text"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "request_end_session"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": ["type", "text"],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["text", "animation", "panel"],
  "additionalProperties": false
}
