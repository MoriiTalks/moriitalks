# pnpm dev:api loads services/api/.env, direct go run reads process environment variables.
API_ADDR=127.0.0.1:8080

# Keep live providers disabled until an adult configures a local voice test.
VOICE_LAB_ENABLED=false
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# OpenAI still screens input and visible output when the coach uses Hermes.
VOICE_COACH_PROVIDER=openai
VOICE_COACH_MODEL=gpt-6-luna
VOICE_COACH_REASONING=none

# Adult PoC only, use an isolated Hermes profile with all tools and personal memory disabled.
# Configure its provider/model first, subscription availability follows the authenticated account.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_PROVIDER=openai-codex
# Optional alias from gateway.platforms.api_server.model_routes, mapped to the same provider.
# The explicit provider makes direct model selection work without direct_model_requests.
HERMES_MODEL_ROUTE=
# Confirm external tool isolation before enabling Hermes, this flag does not enforce isolation.
# Chat requests do not establish zero retention, review Hermes session and log storage separately.
HERMES_NO_TOOLS_CONFIRMED=false

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# Conservative admission reserve, provider invoices and project limits remain separate.
VOICE_MAX_SESSION_USD=0.50
# The reserve persists until this API process exits, no automatic refund on cancellation.
VOICE_MAX_LAB_USD=5.00
